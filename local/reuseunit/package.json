{
    "name": "local_reuseunit",
    "version": "0.1.0",
    "description": "Moodle plugin to reuse sections/units across courses",
    "private": true,
    "scripts": {
        "build": "babel amd/src --out-dir amd/build --out-file-extension .min.js",
        "watch": "babel amd/src --out-dir amd/build --out-file-extension .min.js --watch",
        "lint": "eslint amd/src/",
        "lint:fix": "eslint amd/src/ --fix",
        "clean": "rm -rf amd/build/*"
    },
    "devDependencies": {
        "@babel/cli": "^7.23.0",
        "@babel/core": "^7.23.0",
        "@babel/preset-env": "^7.23.0",
        "eslint": "^8.57.0"
    },
    "babel": {
        "presets": [
            ["@babel/preset-env", {
                "modules": "amd",
                "targets": {
                    "browsers": ["> 0.5%", "last 2 versions", "not dead"]
                }
            }]
        ],
        "comments": false,
        "sourceMaps": "inline",
        "compact": true
    },
    "eslintConfig": {
        "env": {
            "browser": true,
            "es2021": true,
            "amd": true
        },
        "extends": "eslint:recommended",
        "parserOptions": {
            "ecmaVersion": "latest",
            "sourceType": "module"
        },
        "globals": {
            "M": "readonly",
            "Y": "readonly"
        },
        "rules": {
            "no-unused-vars": "warn"
        }
    },
    "author": "hyukudan",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "https://github.com/hyukudan/moodle-reuse-unit"
    }
}
