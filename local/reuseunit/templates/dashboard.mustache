{{!
    Dashboard template for local_reuseunit.

    @package    local_reuseunit
    @copyright  2024 hyukudan
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="reuseunit-dashboard" data-userid="{{userid}}">
    {{! Period filter }}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4>{{#str}}usagestatistics, local_reuseunit{{/str}}</h4>
        <div class="btn-group" role="group" aria-label="{{#str}}periodfilter, local_reuseunit{{/str}}">
            <button type="button" class="btn btn-outline-secondary period-btn active" data-period="all">
                {{#str}}alltime, local_reuseunit{{/str}}
            </button>
            <button type="button" class="btn btn-outline-secondary period-btn" data-period="month">
                {{#str}}lastmonth, local_reuseunit{{/str}}
            </button>
            <button type="button" class="btn btn-outline-secondary period-btn" data-period="week">
                {{#str}}lastweek, local_reuseunit{{/str}}
            </button>
        </div>
    </div>

    {{! Summary cards }}
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card h-100 border-primary">
                <div class="card-body text-center">
                    <h2 class="card-title text-primary stat-totalimports">{{totalimports}}</h2>
                    <p class="card-text text-muted">{{#str}}totalimports, local_reuseunit{{/str}}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card h-100 border-success">
                <div class="card-body text-center">
                    <h2 class="card-title text-success stat-successfulimports">{{successfulimports}}</h2>
                    <p class="card-text text-muted">{{#str}}successfulimports, local_reuseunit{{/str}}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card h-100 border-info">
                <div class="card-body text-center">
                    <h2 class="card-title text-info stat-activitiesimported">{{activitiesimported}}</h2>
                    <p class="card-text text-muted">{{#str}}activitiesimported_stat, local_reuseunit{{/str}}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card h-100 border-warning">
                <div class="card-body text-center">
                    <h2 class="card-title text-warning stat-resourcesimported">{{resourcesimported}}</h2>
                    <p class="card-text text-muted">{{#str}}resourcesimported_stat, local_reuseunit{{/str}}</p>
                </div>
            </div>
        </div>
    </div>

    {{! Template stats }}
    <div class="row mb-4">
        <div class="col-md-6 col-sm-12 mb-3">
            <div class="card h-100 border-secondary">
                <div class="card-body text-center">
                    <h2 class="card-title stat-totaltemplates">{{totaltemplates}}</h2>
                    <p class="card-text text-muted">{{#str}}totaltemplates, local_reuseunit{{/str}}</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-sm-12 mb-3">
            <div class="card h-100 border-secondary">
                <div class="card-body text-center">
                    <h2 class="card-title stat-templateusage">{{templateusage}}</h2>
                    <p class="card-text text-muted">{{#str}}templateusagestat, local_reuseunit{{/str}}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        {{! Top templates }}
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">{{#str}}toptemplates, local_reuseunit{{/str}}</h5>
                </div>
                <div class="card-body">
                    {{#hastoptemplates}}
                    <ul class="list-group list-group-flush top-templates-list">
                        {{#toptemplates}}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                {{name}}
                                <span class="badge badge-secondary ml-2">{{sharelevel}}</span>
                            </span>
                            <span class="badge badge-primary badge-pill">{{usagecount}}</span>
                        </li>
                        {{/toptemplates}}
                    </ul>
                    {{/hastoptemplates}}
                    {{^hastoptemplates}}
                    <p class="text-muted text-center my-3">{{#str}}notemplates, local_reuseunit{{/str}}</p>
                    {{/hastoptemplates}}
                </div>
            </div>
        </div>

        {{! Recent imports }}
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">{{#str}}recentimports, local_reuseunit{{/str}}</h5>
                </div>
                <div class="card-body">
                    {{#hasrecentimports}}
                    <div class="table-responsive">
                        <table class="table table-sm recent-imports-table">
                            <thead>
                                <tr>
                                    <th>{{#str}}section, local_reuseunit{{/str}}</th>
                                    <th>{{#str}}course, local_reuseunit{{/str}}</th>
                                    <th>{{#str}}content, local_reuseunit{{/str}}</th>
                                    <th>{{#str}}when, local_reuseunit{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#recentimports}}
                                <tr>
                                    <td>{{sectionname}}</td>
                                    <td>{{coursename}}</td>
                                    <td>{{activities}}A / {{resources}}R</td>
                                    <td><small class="text-muted">{{timeago}}</small></td>
                                </tr>
                                {{/recentimports}}
                            </tbody>
                        </table>
                    </div>
                    {{/hasrecentimports}}
                    {{^hasrecentimports}}
                    <p class="text-muted text-center my-3">{{#str}}nohistory, local_reuseunit{{/str}}</p>
                    {{/hasrecentimports}}
                </div>
            </div>
        </div>
    </div>

    {{! Charts row }}
    <div class="row">
        {{! Imports by course chart }}
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">{{#str}}importsbycourse, local_reuseunit{{/str}}</h5>
                </div>
                <div class="card-body">
                    <canvas id="importsByCourseChart" height="250"></canvas>
                    <div id="importsByCourseEmpty" class="text-muted text-center my-3 d-none">
                        {{#str}}nodata, local_reuseunit{{/str}}
                    </div>
                </div>
            </div>
        </div>

        {{! Imports by activity type chart }}
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">{{#str}}importsbyactivity, local_reuseunit{{/str}}</h5>
                </div>
                <div class="card-body">
                    <canvas id="importsByActivityChart" height="250"></canvas>
                    <div id="importsByActivityEmpty" class="text-muted text-center my-3 d-none">
                        {{#str}}nodata, local_reuseunit{{/str}}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{! View all toggle for admins }}
    {{#canviewall}}
    <div class="mt-3 text-center">
        <div class="custom-control custom-switch">
            <input type="checkbox" class="custom-control-input" id="viewAllUsersToggle">
            <label class="custom-control-label" for="viewAllUsersToggle">
                {{#str}}viewallusers, local_reuseunit{{/str}}
            </label>
        </div>
    </div>
    {{/canviewall}}
</div>

{{! Hidden data for JS }}
<script type="application/json" id="importsByCourseData">{{{importsbycourse}}}</script>
<script type="application/json" id="importsByActivityData">{{{importsbyactivity}}}</script>
